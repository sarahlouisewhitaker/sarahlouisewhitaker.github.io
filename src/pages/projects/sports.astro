.data-content{max-width:900px;margin:auto;padding:0 1rem 5rem}.data-hero{text-align:center;max-width:720px;margin:0 auto 5rem}.big{font-size:clamp(4rem,11vw,8rem);line-height:.9;color:var(--rose);text-shadow:0 0 25px rgba(239,180,202,.18)}.data-hero h2{font-weight:500}.data-content section{margin-bottom:4.5rem}.data-content section>p:not(.section-label){line-height:1.8;color:rgba(255,245,250,.82)}.pipeline{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:.6rem;align-items:center;margin:1.2rem 0}.pipeline div,.stats div,.cards div,.validation{background:rgba(8,10,22,.58);border:1px solid rgba(239,180,202,.25);border-radius:10px;padding:1.2rem;text-align:center}.pipeline b,.stats b,.cards b{display:block;color:var(--rose)}.pipeline small{display:block;opacity:.7;margin-top:.4rem}.pipeline i{color:var(--rose)}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin:1.2rem 0}.stats b{font-size:1.35rem}.stats span{font-size:.75rem;opacity:.7}.cards{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-top:1.2rem}.cards{text-align:left}.cards div{text-align:left}.cards h3{margin:.5rem 0}.cards p{margin:0;line-height:1.6;font-size:.85rem;opacity:.78}.validation{margin-top:1.2rem}.validation>div{color:var(--rose);margin-bottom:1rem}.validation p{margin:0;line-height:1.7;opacity:.8}.tags{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.2rem}.tags span{padding:.55rem .8rem;border:1px solid rgba(239,180,202,.35);border-radius:99px;color:var(--rose);font-size:.72rem;background:rgba(8,10,22,.42)}@media(max-width:650px){.pipeline{grid-template-columns:1fr}.pipeline i{transform:rotate(90deg)}.stats{grid-template-columns:1fr}.cards{grid-template-columns:1fr}}
