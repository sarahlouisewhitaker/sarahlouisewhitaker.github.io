<section class="chapter is-centered" id="question" data-reveal>
  <h2 class="vh">The question</h2>
  <div class="paper-card">
    <p class="question">Is cross country a team sport? Do runners race differently as part of a team than they do unattached?</p>
    <span class="seal is-stamp" aria-hidden="true">SW</span>
  </div>
</section>

