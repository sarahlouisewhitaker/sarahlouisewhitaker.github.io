---
import "../../styles/global.css";
import AnimatedBackground from "../../components/AnimatedBackground.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker's QA and automation work." />
    <title>qa & automation · sarahwhitaker</title>
  </head>
  <body class="night-design project-page">
    <AnimatedBackground />

    <main>
      <header class="project-hero">
        <a class="back-link" href="/">♡ back home</a>
        <p class="project-kicker">FEATURED WORK</p>
        <h1>qa &amp; automation</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="project-subtitle">testing · automation · troubleshooting</p>
      </header>

      <article class="case-study">
        <section class="case-section">
          <p class="section-label">OVERVIEW</p>
          <p>
            My current QA work combines manual testing, UI automation, troubleshooting,
            and collaboration with development and customer-facing teams. I work through
            user flows, look for unexpected behavior, write automated checks where they
            are useful, and help communicate technical issues clearly.
          </p>
        </section>

        <section class="case-section">
          <p class="section-label">WHAT I DO</p>
          <div class="case-grid">
            <div class="case-card">
              <span class="case-number">01</span>
              <h2>Manual testing</h2>
              <p>Walk through flows and UI behavior to catch issues before they reach users.</p>
            </div>
            <div class="case-card">
              <span class="case-number">02</span>
              <h2>Automation</h2>
              <p>Build UI automations and repeatable checks to make testing more efficient.</p>
            </div>
            <div class="case-card">
              <span class="case-number">03</span>
              <h2>Troubleshooting</h2>
              <p>Investigate unexpected behavior and work with developers to understand and resolve issues.</p>
            </div>
            <div class="case-card">
              <span class="case-number">04</span>
              <h2>Integrations</h2>
              <p>Help onboard merchant payment integrations by coordinating requirements with payment providers and internal teams.</p>
            </div>
          </div>
        </section>

        <section class="case-section">
          <p class="section-label">HOW I WORK</p>
          <div class="process">
            <div><span>01</span><p>Understand the expected behavior</p></div>
            <div><span>02</span><p>Test the flow and edge cases</p></div>
            <div><span>03</span><p>Document and communicate findings</p></div>
            <div><span>04</span><p>Automate repeatable checks when it makes sense</p></div>
          </div>
        </section>

        <section class="case-section closing-section">
          <p class="section-label">THE TAKEAWAY</p>
          <p>
            QA for me is more than checking whether a button works. I like understanding
            how a system is supposed to behave, finding where that behavior breaks down,
            and making the problem easier for the rest of the team to solve.
          </p>
        </section>
      </article>

      <footer>
        <nav class="social-links" aria-label="Social links">
          <a href="https://github.com/sarahlouisewhitaker" target="_blank" rel="noopener noreferrer">GITHUB</a>
          <span aria-hidden="true">♡</span>
          <a href="https://www.linkedin.com/in/sarah-louise-whitaker" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
