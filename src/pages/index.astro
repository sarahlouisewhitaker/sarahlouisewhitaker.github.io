<style is:global>
/* 3D companion: a fixed box the script moves from the header slot to the corner */
#companion{position:fixed;left:0;top:0;width:260px;height:290px;transform-origin:0 0;z-index:30;cursor:pointer;will-change:transform;visibility:hidden}
.companion-on #companion{visibility:visible}
/* a little speech bubble when the cat swaps what it's holding */
#bubble{position:fixed;left:0;top:0;z-index:31;pointer-events:none;padding:7px 13px;background:#fbf7f0;border:1px solid var(--line);border-radius:14px 14px 4px 14px;font-family:'Shippori Mincho';font-size:13px;letter-spacing:.06em;color:var(--ink);white-space:nowrap;box-shadow:0 8px 18px -12px #1d1a1766;opacity:0;transform-origin:100% 100%}
#bubble.say{animation:say 1.9s cubic-bezier(.2,.8,.2,1)}
@keyframes say{0%{opacity:0;scale:.6}12%{opacity:1;scale:1.04}20%{scale:1}82%{opacity:1}100%{opacity:0;scale:.96}}
#companion .stage{position:absolute;inset:0}
#companion canvas{position:absolute;inset:0;z-index:2;filter:saturate(.55) sepia(.2) contrast(.97);transition:filter .5s}
#companion:hover canvas{filter:none}
/* the flat cat inside the box, placed so it lines up with the header slot when docked */
#companion .flat{position:absolute;left:10%;top:6.4%;width:80%;height:80%}
#companion.is-3d .flat{display:none}
#companion:not(.docked):after{content:'';position:absolute;left:24%;right:24%;bottom:3%;height:16px;border-radius:50%;background:#1d1a1714;z-index:-1}
#companion .spark{position:absolute;color:var(--gold);font-size:30px;opacity:0;pointer-events:none}
#companion .s1{left:4%;top:22%}#companion .s2{right:8%;top:10%;font-size:22px}#companion .s3{right:2%;top:50%;font-size:36px}#companion .s4{left:14%;top:4%;font-size:20px}
#companion.sparkle .spark{animation:spark .9s ease-out forwards}
#companion.sparkle .s2{animation-delay:.08s}#companion.sparkle .s3{animation-delay:.16s}#companion.sparkle .s4{animation-delay:.24s}
/* once the 3D cat exists, the flat one in the header steps aside (its slot stays for layout) */
.companion-on .cat img,.companion-on .cat .spark{visibility:hidden}.companion-on .cat{animation:none}
</style>
