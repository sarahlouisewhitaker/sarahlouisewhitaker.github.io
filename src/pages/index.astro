<style is:global>
/* header: same layout as 07 Washi, with a small lucky-cat illustration in place of the circle */
.hero{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:clamp(16px,4vw,56px);align-items:center;padding:24px clamp(16px,5vw,64px) 56px;min-height:64vh}
.tate{writing-mode:vertical-rl;font-family:var(--font-display);font-size:13px;letter-spacing:.45em;color:var(--sumi);height:300px;text-align:center}
.center{text-align:center}
.cat{position:relative;display:inline-block;width:clamp(140px,16vw,190px);aspect-ratio:500/558;cursor:pointer;animation:settle 1s cubic-bezier(.3,1.5,.5,1) .2s both,idle 4.5s ease-in-out 1.2s infinite}
@keyframes settle{from{opacity:0;transform:translateY(16px) scale(.92)}}
@keyframes idle{50%{transform:translateY(-6px)}}
.cat img,.flat img{position:absolute;inset:0;width:100%;height:100%;filter:saturate(.45) sepia(.25) contrast(.95);transition:filter .6s}
.cat:hover img,#companion:hover .flat img{filter:none}
.cat:hover{animation:hop .7s cubic-bezier(.3,1.4,.5,1)}
@keyframes hop{30%{transform:translateY(-16px)}55%{transform:translateY(0) scale(1.03,.96)}75%{transform:translateY(-3px)}}
.cat:hover:after{animation:shadow .7s cubic-bezier(.3,1.4,.5,1)}
@keyframes shadow{30%{transform:scaleX(.7);opacity:.5}}
.spark{position:absolute;color:var(--gold);font-size:16px;opacity:0;pointer-events:none;z-index:2}
.spark.s1{left:-8%;top:18%}.spark.s2{right:-6%;top:6%;font-size:12px}.spark.s3{right:-12%;top:46%;font-size:20px}.spark.s4{left:2%;top:-4%;font-size:11px}
.cat:hover .spark{animation:spark .9s ease-out forwards}
.cat:hover .s2{animation-delay:.08s}.cat:hover .s3{animation-delay:.16s}.cat:hover .s4{animation-delay:.24s}
@keyframes spark{0%{opacity:0;transform:scale(.2) rotate(0)}40%{opacity:1;transform:scale(1.2) rotate(40deg)}100%{opacity:0;transform:translateY(-14px) scale(.8) rotate(90deg)}}
/* same picture twice: the body with the raised paw cut out, and the paw alone, pivoting at the wrist */
.cat .body,.flat .body{z-index:1;clip-path:polygon(0 0,100% 0,100% 100%,0 100%,0 47.2%,14.4% 47.2%,26.4% 49%,18.4% 37.1%,19.4% 33.3%,0 33.3%)}
.cat .paw,.flat .paw{z-index:0;clip-path:polygon(0 33.3%,19.4% 33.3%,19.6% 37.1%,28% 49.8%,14.4% 48%,0 48%);transform-origin:14.4% 48%;animation:beckon 1.6s ease-in-out infinite}
@keyframes beckon{0%,100%{transform:rotate(0)}45%{transform:rotate(7deg)}}
.cat:after{content:'';position:absolute;left:18%;right:18%;bottom:1%;height:10px;border-radius:50%;background:var(--shade);z-index:-1}
/* shown until the real art file exists */
.cat .slot{display:none;position:absolute;inset:0;border:1.5px dashed var(--line);border-radius:50%;place-items:center;font-size:10px;letter-spacing:.25em;color:var(--sumi);line-height:1.8;padding:24px}
.cat.empty img{display:none}.cat.empty{animation:none}.cat.empty .slot{display:grid}
.name{margin-top:22px}
.name h1{font-family:var(--font-display);font-weight:400;font-size:22px;letter-spacing:.4em;text-transform:uppercase}
.name p{font-family:var(--font-label);font-size:11px;letter-spacing:.35em;color:var(--sumi);margin-top:6px}
.name .rule{width:0;height:1px;background:var(--seal);margin:18px auto 0;animation:rule 1.2s cubic-bezier(.2,.8,.2,1) .8s forwards}
@keyframes rule{to{width:48px}}
/* about me: a centered ruled fact list */
.facts{list-style:none;padding:0;max-width:520px;margin:0 auto;border-top:1px solid var(--line)}
.facts li{position:relative;isolation:isolate;display:grid;grid-template-columns:1fr 22px 120px minmax(0,220px) 1fr;column-gap:10px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line);font-size:14px;cursor:default;transition:border-color .3s}
.facts li:before{content:'+';grid-column:2;font-size:17px;line-height:1;text-align:center;color:var(--gold);transition:transform .45s cubic-bezier(.3,1.6,.5,1),color .3s}
.facts li:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,transparent,var(--card) 18%,var(--card) 82%,transparent);transform:scaleX(0);transition:transform .45s cubic-bezier(.2,.8,.2,1)}
.facts .k{grid-column:3;font-family:var(--font-label);font-size:11px;letter-spacing:.25em;color:var(--sumi);transition:color .3s,letter-spacing .4s}
.facts .v{grid-column:4;transition:transform .4s cubic-bezier(.2,.8,.2,1)}
.facts li:hover{border-color:var(--seal)}
.facts li:hover:before{transform:rotate(45deg);color:var(--seal)}
.facts li:hover:after{transform:scaleX(1)}
.facts li:hover .k{color:var(--seal);letter-spacing:.32em}
.facts li:hover .v{transform:translateX(6px)}
.facts a{text-decoration:none;border-bottom:1px solid transparent;transition:border-color .3s}
.facts a:hover{border-color:var(--ink)}
/* illustrations tucked into the work cards */
.work .art{position:absolute;right:18px;top:16px;width:110px;height:110px;object-fit:contain;opacity:.32;filter:grayscale(1) sepia(.35);transform:rotate(6deg);transition:opacity .5s,filter .5s,transform .6s cubic-bezier(.3,1.5,.5,1)}
.work:hover .art{opacity:1;filter:saturate(.6) sepia(.15);transform:rotate(-4deg) translateY(-4px) scale(1.06)}
.work h3,.work .meta{padding-right:110px}
.work .scene{display:block}
.scene .tv{position:absolute;right:0;top:0;width:68%}
.scene .glow{position:absolute;right:16%;top:10%;width:36%;height:26%;border-radius:8px;background:#fff6d8;opacity:0;mix-blend-mode:screen}
.work:hover .scene .glow{animation:flicker 1.6s steps(1) infinite}
@keyframes flicker{0%{opacity:.35}20%{opacity:.15}35%{opacity:.45}55%{opacity:.2}70%{opacity:.4}}
.scene .viewer{position:absolute;left:-14%;bottom:-8%;width:38%;transform-origin:50% 100%;transition:transform .5s cubic-bezier(.3,1.5,.5,1)}
.work:hover .scene .viewer{transform:rotate(-6deg)}
/* palette: plain swatches named after cat coats */
.coats2{display:flex;flex-wrap:wrap;justify-content:center;gap:22px}
.sw{background:none;border:0;font:inherit;font-family:var(--font-label);cursor:pointer;text-align:center;color:var(--sumi);font-size:11px;letter-spacing:.15em;width:72px}
.sw i{display:block;width:48px;height:48px;border-radius:50%;margin:0 auto 10px;border:1px solid var(--line);transition:transform .4s cubic-bezier(.3,1.6,.5,1),border-radius .4s}
.sw:hover i{transform:translateY(-6px) scale(1.08);border-radius:30%}
.sw small{display:block;font-size:10px;margin-top:2px;opacity:.7}
html{scroll-behavior:smooth}
@media(max-width:760px){.hero{min-height:auto;padding-top:40px;padding-bottom:72px}}
/* the smallest phones: four nav links + the stamp only fit with tighter spacing */
@media(max-width:380px){nav a{margin-left:11px;letter-spacing:.1em}}
:focus-visible{outline:2px solid var(--seal);outline-offset:4px}
/* hero: the name and side text arrive after the cat settles */
.name h1,.name p{opacity:0;transform:translateY(10px);animation:rise .9s cubic-bezier(.2,.8,.2,1) forwards}
.name h1{animation-delay:.35s}.name p{animation-delay:.55s}
.tate{opacity:0;animation:fadein 1.4s ease .9s forwards}
@keyframes rise{to{opacity:1;transform:none}}
@keyframes fadein{to{opacity:1}}
/* sections ease in as they reach the viewport */
.reveal{opacity:0;transform:translateY(18px);transition:opacity 1s cubic-bezier(.2,.8,.2,1),transform 1s cubic-bezier(.2,.8,.2,1)}
.reveal.in{opacity:1;transform:none}
/* nav: the link for the section you're reading stays underlined */
nav a.here:after{transform:scaleX(1)}
/* footer: name, seal, links on one line; credits quietly underneath */
footer{flex-wrap:wrap;row-gap:20px}
footer .credits{flex-basis:100%;order:3;margin:0;text-align:center;font-family:var(--font-body);font-size:10.5px;letter-spacing:.08em;line-height:1.9;color:var(--sumi)}
footer .credits a{color:inherit}
@media(max-width:760px){footer{flex-direction:column;text-align:center;gap:10px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.name h1,.name p,.reveal{opacity:1;transform:none;animation:none;transition:none}.tate{opacity:1;animation:none}}
@media(max-width:760px){.hero{grid-template-columns:1fr}.tate{display:none}.work .art{width:76px;height:76px}.work h3,.work .meta{padding-right:70px}.facts li{grid-template-columns:0 22px 104px 1fr 0;column-gap:8px}footer .seal{display:none}}
</style>
