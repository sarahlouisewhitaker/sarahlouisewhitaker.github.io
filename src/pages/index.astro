---
import "../styles/global.css";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body class="night-design">
    <div class="sky-art" aria-hidden="true">
      <div class="moon"></div>
      <div class="stars">
        <i class="star star-1"></i>
        <i class="star star-2"></i>
        <i class="star star-3"></i>
        <i class="star star-4"></i>
        <i class="star star-5"></i>
        <i class="star star-6"></i>
        <i class="star star-7"></i>
        <i class="star star-8"></i>
      </div>

      <div class="branch branch-left">
        <span class="twig twig-1"></span>
        <span class="twig twig-2"></span>
        <span class="twig twig-3"></span>
        <span class="twig twig-4"></span>
        <i class="blossom blossom-a"></i>
        <i class="blossom blossom-b"></i>
        <i class="blossom blossom-c"></i>
        <i class="blossom blossom-d"></i>
        <i class="bud bud-a"></i>
        <i class="bud bud-b"></i>
      </div>
    </div>

    <main>
      <header class="hero">
        <div class="hero-heart">♡</div>
        <h1>sarahwhitaker</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="intro">STATISTICS&nbsp;&nbsp;·&nbsp;&nbsp; QA&nbsp;&nbsp; ·&nbsp;&nbsp; DATA&nbsp;&nbsp; ·&nbsp;&nbsp; RESEARCH</p>
      </header>

      <section id="work">
        <div class="section-heading">
          <span></span>
          <p class="section-label">FEATURED WORK</p>
          <span></span>
        </div>

        <div class="work-grid">
          <a class="project" href="#about">
            <span class="project-ornament">✦</span>
            <h2>DATA &amp; STATISTICS</h2>
            <p>analysis&nbsp;&nbsp; · &nbsp;&nbsp;research&nbsp;&nbsp; · &nbsp;&nbsp;modeling</p>
            <span class="project-link">→</span>
          </a>

          <a class="project" href="#writing">
            <span class="project-ornament">♡</span>
            <h2>QA &amp; AUTOMATION</h2>
            <p>testing&nbsp;&nbsp; · &nbsp;&nbsp;automation&nbsp;&nbsp; · &nbsp;&nbsp;payments</p>
            <span class="project-link">→</span>
          </a>
        </div>
      </section>

      <section id="about" class="about-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">A LITTLE ABOUT ME</p>
          <span></span>
        </div>
        <div class="about-copy">
          <p>I'm a statistics graduate interested in</p>
          <p>data, quality, automation, and</p>
          <p>building thoughtful things.</p>
        </div>
      </section>

      <section id="writing" class="writing-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">WRITING</p>
          <span></span>
        </div>
        <p class="writing-copy">notes, projects, and things i learn along the way.</p>
        <span class="coming-soon">COMING SOON</span>
      </section>

      <footer>
        <span>♡</span>
        <span>made with curiosity</span>
        <span>♡</span>
      </footer>
    </main>
  </body>
</html>
