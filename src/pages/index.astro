---
import "../styles/global.css";
import AnimatedBackground from "../components/AnimatedBackground.astro";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body class="night-design">
    <AnimatedBackground />

    <main>
      <header class="hero">
        <div class="hero-heart">♡</div>
        <h1>sarahwhitaker</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="intro">STATISTICS&nbsp;&nbsp;·&nbsp;&nbsp; QA&nbsp;&nbsp; ·&nbsp;&nbsp; DATA&nbsp;&nbsp; ·&nbsp;&nbsp; RESEARCH</p>
      </header>

      <section id="work">
        <div class="section-heading">
          <span></span>
          <p class="section-label">FEATURED WORK</p>
          <span></span>
        </div>

        <nav class="featured-work" aria-label="Featured work">
          <a class="work-link" href="/projects/studio-ghibli-revenue-analysis/">
            <span>studio ghibli revenue analysis</span>
            <span class="work-link-mark" aria-hidden="true">✦</span>
          </a>
          <a class="work-link" href="/projects/sports-analytics-research/">
            <span>sports analytics research</span>
            <span class="work-link-mark" aria-hidden="true">✦</span>
          </a>
          <a class="work-link" href="/projects/qa-automation/">
            <span>qa &amp; automation</span>
            <span class="work-link-mark" aria-hidden="true">✦</span>
          </a>
        </nav>
      </section>

      <footer>
        <nav class="social-links" aria-label="Social links">
          <a href="https://github.com/sarahlouisewhitaker" target="_blank" rel="noopener noreferrer">GITHUB</a>
          <span aria-hidden="true">♡</span>
          <a href="https://www.linkedin.com/in/sarah-louise-whitaker" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
        </nav>
        <div class="footer-note">
          <span>♡</span>
          <span>made with curiosity</span>
          <span>♡</span>
        </div>
      </footer>
    </main>
  </body>
</html>
