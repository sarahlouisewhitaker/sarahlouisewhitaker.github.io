---
import "../styles/global.css";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body class="night-design">
    <div class="sky-art" aria-hidden="true">
  <svg class="pixel-sky" viewBox="0 0 480 330" role="presentation" focusable="false" shape-rendering="crispEdges">
    <!-- moon -->
    <g class="pixel-moon">
      <path fill="#f7eddc" d="M246 30h12v4h8v8h8v12h4v20h-4v12h-8v8h-12v4h-20v-4h-12v-8h-8V74h-4V54h4V42h8v-8h12v-4z"/>
      <path fill="#080a18" d="M258 34h12v8h8v12h4v20h-4v12h-8v8h-12v4h-16v-8h-8V78h-4V58h4V46h8v-8h16z"/>
      <rect x="234" y="43" width="4" height="4" fill="#fff8e9"/>
      <rect x="230" y="47" width="4" height="16" fill="#fff8e9"/>
      <rect x="234" y="63" width="4" height="4" fill="#ead8cc"/>
    </g>

    <!-- stars -->
    <g class="pixel-stars">
      <path fill="#f7d8e6" d="M72 34h4v6h6v4h-6v6h-4v-6h-6v-4h6z"/>
      <path fill="#fff0d6" d="M404 28h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <path fill="#f7d8e6" d="M350 74h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path fill="#fff0d6" d="M120 102h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <path fill="#f7d8e6" d="M430 136h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path fill="#fff0d6" d="M82 154h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <path fill="#f7d8e6" d="M296 146h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path fill="#fff0d6" d="M372 190h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <rect x="188" y="29" width="4" height="4" fill="#f7d8e6"/>
      <rect x="322" y="34" width="4" height="4" fill="#c9a8bd"/>
      <rect x="42" y="118" width="4" height="4" fill="#f7d8e6"/>
      <rect x="442" y="82" width="4" height="4" fill="#c9a8bd"/>
      <rect x="270" y="122" width="4" height="4" fill="#c9a8bd"/>
    </g>

    <!-- cherry blossom branch -->
    <g class="pixel-branch">
      <path fill="#3a2940" d="M0 70h24v4h24v8h20v8h20v8h20v8h20v8h20v8h20v8h20v8h20v8h-20v-4h-20v-8h-20v-8h-20v-8h-20v-8H88v-8H68v-8H48v-8H24v-4H0z"/>
      <path fill="#68465f" d="M0 66h24v4h24v8h20v8h20v8h20v8h20v8h20v8h20v8h20v4h-20v-4h-20v-8h-20v-8h-20v-8H88v-8H68v-8H48v-8H24v-4H0z"/>
      <path fill="#3a2940" d="M62 86h10v-18h8V52h8v34h-8v10h-8v8H62zM112 106h8V82h8V62h8v38h-8v10h-8v8h-8zm48 12h8v-20h8V82h8v28h-8v10h-8v8h-8z"/>
      <path fill="#3a2940" d="M84 68h8v-20h8V30h8v34h-8v12h-8v8h-8zM138 80h8V58h8V42h8v30h-8v12h-8v8h-8z"/>

      <!-- blossom clusters -->
      <g fill="#efb4ca">
        <path d="M18 48h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M54 76h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M82 30h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M104 58h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M132 18h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M158 48h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M196 30h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
      </g>
      <g fill="#b96891">
        <rect x="26" y="48" width="8" height="8"/>
        <rect x="62" y="76" width="8" height="8"/>
        <rect x="90" y="30" width="8" height="8"/>
        <rect x="112" y="58" width="8" height="8"/>
        <rect x="140" y="18" width="8" height="8"/>
        <rect x="166" y="48" width="8" height="8"/>
        <rect x="204" y="30" width="8" height="8"/>
      </g>
      <g fill="#fff0bf">
        <rect x="28" y="50" width="4" height="4"/>
        <rect x="64" y="78" width="4" height="4"/>
        <rect x="92" y="32" width="4" height="4"/>
        <rect x="114" y="60" width="4" height="4"/>
        <rect x="142" y="20" width="4" height="4"/>
        <rect x="168" y="50" width="4" height="4"/>
        <rect x="206" y="32" width="4" height="4"/>
      </g>
      <rect x="36" y="90" width="8" height="8" fill="#efb4ca"/>
      <rect x="178" y="74" width="8" height="8" fill="#efb4ca"/>
      <rect x="218" y="50" width="8" height="8" fill="#efb4ca"/>
    </g>

    <!-- drifting petals -->
    <g fill="#ef9fbd">
      <path d="M214 112h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M92 206h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M386 124h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M338 206h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M48 246h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
    </g>

    <!-- low pixel clouds -->
    <g class="pixel-clouds">
      <path fill="#514568" d="M0 236h20v-8h16v-8h20v8h12v8h16v8h18v12H0z"/>
      <path fill="#403552" d="M0 248h28v-8h16v-8h16v8h12v8h20v8H0z"/>
      <path fill="#514568" d="M396 250h20v-8h16v-8h20v8h28v24h-84z"/>
      <path fill="#403552" d="M374 266h28v-8h20v-8h20v8h38v20h-106z"/>
      <path fill="#514568" d="M72 292h22v-8h18v-8h18v8h20v8h24v16H72z"/>
      <path fill="#403552" d="M312 298h18v-8h22v-8h20v8h20v8h24v14h-104z"/>
    </g>
  </svg>
</div>
      <div class="stars">
        <i class="star star-1"></i>
        <i class="star star-2"></i>
        <i class="star star-3"></i>
        <i class="star star-4"></i>
        <i class="star star-5"></i>
        <i class="star star-6"></i>
        <i class="star star-7"></i>
        <i class="star star-8"></i>
      </div>

      <div class="branch branch-left">
        <span class="twig twig-1"></span>
        <span class="twig twig-2"></span>
        <span class="twig twig-3"></span>
        <span class="twig twig-4"></span>
        <i class="blossom blossom-a"></i>
        <i class="blossom blossom-b"></i>
        <i class="blossom blossom-c"></i>
        <i class="blossom blossom-d"></i>
        <i class="bud bud-a"></i>
        <i class="bud bud-b"></i>
      </div>
    </div>

    <main>
      <header class="hero">
        <div class="hero-heart">♡</div>
        <h1>sarahwhitaker</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="intro">STATISTICS&nbsp;&nbsp;·&nbsp;&nbsp; QA&nbsp;&nbsp; ·&nbsp;&nbsp; DATA&nbsp;&nbsp; ·&nbsp;&nbsp; RESEARCH</p>
      </header>

      <section id="work">
        <div class="section-heading">
          <span></span>
          <p class="section-label">FEATURED WORK</p>
          <span></span>
        </div>

        <div class="work-grid">
          <a class="project" href="#about">
            <span class="project-ornament">✦</span>
            <h2>DATA &amp; STATISTICS</h2>
            <p>analysis&nbsp;&nbsp; · &nbsp;&nbsp;research&nbsp;&nbsp; · &nbsp;&nbsp;modeling</p>
            <span class="project-link">→</span>
          </a>

          <a class="project" href="#writing">
            <span class="project-ornament">♡</span>
            <h2>QA &amp; AUTOMATION</h2>
            <p>testing&nbsp;&nbsp; · &nbsp;&nbsp;automation&nbsp;&nbsp; · &nbsp;&nbsp;payments</p>
            <span class="project-link">→</span>
          </a>
        </div>
      </section>

      <section id="about" class="about-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">A LITTLE ABOUT ME</p>
          <span></span>
        </div>
        <div class="about-copy">
          <p>I'm a statistics graduate interested in</p>
          <p>data, quality, automation, and</p>
          <p>building thoughtful things.</p>
        </div>
      </section>

      <section id="writing" class="writing-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">WRITING</p>
          <span></span>
        </div>
        <p class="writing-copy">notes, projects, and things i learn along the way.</p>
        <span class="coming-soon">COMING SOON</span>
      </section>

      <footer>
        <span>♡</span>
        <span>made with curiosity</span>
        <span>♡</span>
      </footer>
    </main>
  </body>
</html>
