<script is:inline>
const revealer=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');revealer.unobserve(e.target)}}),{rootMargin:'0px 0px -12% 0px'});
document.querySelectorAll('.reveal').forEach(el=>revealer.observe(el));
const navLinks={about:document.querySelector('nav a[href="#about"]'),work:document.querySelector('nav a[href="#work"]')};
new IntersectionObserver(es=>es.forEach(e=>navLinks[e.target.id].classList.toggle('here',e.isIntersecting)),{rootMargin:'-45% 0px -45% 0px'}).observe(document.getElementById('about'));
new IntersectionObserver(es=>es.forEach(e=>navLinks[e.target.id].classList.toggle('here',e.isIntersecting)),{rootMargin:'-45% 0px -45% 0px'}).observe(document.getElementById('work'));
</script>
