---
import "../styles/global.css";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body class="night-design">
    <div class="sky-art" aria-hidden="true">
  <svg class="pixel-sky" viewBox="0 0 480 330" role="presentation" focusable="false" shape-rendering="crispEdges">
    <g class="pixel-moon">
      <path fill="#f7eddc" d="M246 30h12v4h8v8h8v12h4v20h-4v12h-8v8h-12v4h-20v-4h-12v-8h-8V74h-4V54h4V42h8v-8h12v-4z"/>
      <path fill="#080a18" d="M258 34h12v8h8v12h4v20h-4v12h-8v8h-12v4h-16v-8h-8V78h-4V58h4V46h8v-8h16z"/>
      <rect x="234" y="43" width="4" height="4" fill="#fff8e9"/><rect x="230" y="47" width="4" height="16" fill="#fff8e9"/><rect x="234" y="63" width="4" height="4" fill="#ead8cc"/>
    </g>
    <g class="pixel-stars">
      <path fill="#f7d8e6" d="M72 34h4v6h6v4h-6v6h-4v-6h-6v-4h6z"/><path fill="#fff0d6" d="M404 28h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <path fill="#f7d8e6" d="M350 74h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path fill="#fff0d6" d="M120 102h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <path fill="#f7d8e6" d="M430 136h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path fill="#fff0d6" d="M82 154h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <path fill="#f7d8e6" d="M296 146h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path fill="#fff0d6" d="M372 190h4v8h4v4h-4v8h-4v-8h-4v-4h4z"/>
      <rect x="188" y="29" width="4" height="4" fill="#f7d8e6"/><rect x="322" y="34" width="4" height="4" fill="#c9a8bd"/><rect x="42" y="118" width="4" height="4" fill="#f7d8e6"/><rect x="442" y="82" width="4" height="4" fill="#c9a8bd"/><rect x="270" y="122" width="4" height="4" fill="#c9a8bd"/>
    </g>
    <g class="pixel-branch">
      <path fill="#30233a" d="M0 66h24v4h24v8h20v8h20v8h20v8h20v8h20v8h20v8h20v8h20v8h-20v-4h-20v-8h-20v-8h-20v-8h-20v-8H88v-8H68v-8H48v-8H24v-4H0z"/>
      <path fill="#69475f" d="M0 62h24v4h24v8h20v8h20v8h20v8h20v8h20v8h20v8h20v4h-20v-4h-20v-8h-20v-8h-20v-8H88v-8H68v-8H48v-8H24v-4H0z"/>
      <path fill="#30233a" d="M56 82h10V62h8V42h8v40h-8v12h-8v8H56zM106 104h10V80h8V58h8v40h-8v12h-8v8h-10zM156 116h10V94h8V72h8v34h-8v12h-8v8h-10zM78 70h8V48h8V28h8v38h-8v12h-8v8h-8zM132 80h8V58h8V38h8v36h-8v12h-8v8h-8zM184 98h8V78h8V60h8v32h-8v12h-8v8h-8z"/>
      <g fill="#efb4ca">
        <path d="M18 46h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M48 74h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M78 28h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M104 56h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M132 16h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M158 44h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M192 26h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M32 94h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/><path d="M174 76h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
      </g>
      <g fill="#b96891"><rect x="26" y="46" width="8" height="8"/><rect x="56" y="74" width="8" height="8"/><rect x="86" y="28" width="8" height="8"/><rect x="112" y="56" width="8" height="8"/><rect x="140" y="16" width="8" height="8"/><rect x="166" y="44" width="8" height="8"/><rect x="200" y="26" width="8" height="8"/><rect x="40" y="94" width="8" height="8"/><rect x="182" y="76" width="8" height="8"/></g>
      <g fill="#fff0bf"><rect x="28" y="48" width="4" height="4"/><rect x="58" y="76" width="4" height="4"/><rect x="88" y="30" width="4" height="4"/><rect x="114" y="58" width="4" height="4"/><rect x="142" y="18" width="4" height="4"/><rect x="168" y="46" width="4" height="4"/><rect x="202" y="28" width="4" height="4"/><rect x="42" y="96" width="4" height="4"/><rect x="184" y="78" width="4" height="4"/></g>
    </g>
    <g fill="#ef9fbd">
      <path d="M214 112h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path d="M92 206h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path d="M386 124h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path d="M338 206h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path d="M48 246h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/><path d="M412 222h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
    </g>
    <g class="pixel-clouds">
      <path fill="#514568" d="M0 236h20v-8h16v-8h20v8h12v8h16v8h18v12H0z"/><path fill="#403552" d="M0 248h28v-8h16v-8h16v8h12v8h20v8H0z"/>
      <path fill="#514568" d="M396 250h20v-8h16v-8h20v8h28v24h-84z"/><path fill="#403552" d="M374 266h28v-8h20v-8h20v8h38v20h-106z"/>
      <path fill="#514568" d="M72 292h22v-8h18v-8h18v8h20v8h24v16H72z"/><path fill="#403552" d="M312 298h18v-8h22v-8h20v8h20v8h24v14H312z"/>
    </g>
  </svg>
</div>
      <div class="stars">
        <i class="star star-1"></i>
        <i class="star star-2"></i>
        <i class="star star-3"></i>
        <i class="star star-4"></i>
        <i class="star star-5"></i>
        <i class="star star-6"></i>
        <i class="star star-7"></i>
        <i class="star star-8"></i>
      </div>

      <div class="branch branch-left">
        <span class="twig twig-1"></span>
        <span class="twig twig-2"></span>
        <span class="twig twig-3"></span>
        <span class="twig twig-4"></span>
        <i class="blossom blossom-a"></i>
        <i class="blossom blossom-b"></i>
        <i class="blossom blossom-c"></i>
        <i class="blossom blossom-d"></i>
        <i class="bud bud-a"></i>
        <i class="bud bud-b"></i>
      </div>
    </div>

    <main>
      <header class="hero">
        <div class="hero-heart">♡</div>
        <h1>sarahwhitaker</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="intro">STATISTICS&nbsp;&nbsp;·&nbsp;&nbsp; QA&nbsp;&nbsp; ·&nbsp;&nbsp; DATA&nbsp;&nbsp; ·&nbsp;&nbsp; RESEARCH</p>
      </header>

      <section id="work">
        <div class="section-heading">
          <span></span>
          <p class="section-label">FEATURED WORK</p>
          <span></span>
        </div>

        <div class="work-grid">
          <a class="project" href="#about">
            <span class="project-ornament">✦</span>
            <h2>DATA &amp; STATISTICS</h2>
            <p>analysis&nbsp;&nbsp; · &nbsp;&nbsp;research&nbsp;&nbsp; · &nbsp;&nbsp;modeling</p>
            <span class="project-link">→</span>
          </a>

          <a class="project" href="#writing">
            <span class="project-ornament">♡</span>
            <h2>QA &amp; AUTOMATION</h2>
            <p>testing&nbsp;&nbsp; · &nbsp;&nbsp;automation&nbsp;&nbsp; · &nbsp;&nbsp;payments</p>
            <span class="project-link">→</span>
          </a>
        </div>
      </section>

      <section id="about" class="about-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">A LITTLE ABOUT ME</p>
          <span></span>
        </div>
        <div class="about-copy">
          <p>I'm a statistics graduate interested in</p>
          <p>data, quality, automation, and</p>
          <p>building thoughtful things.</p>
        </div>
      </section>

      <section id="writing" class="writing-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">WRITING</p>
          <span></span>
        </div>
        <p class="writing-copy">notes, projects, and things i learn along the way.</p>
        <span class="coming-soon">COMING SOON</span>
      </section>

      <footer>
        <span>♡</span>
        <span>made with curiosity</span>
        <span>♡</span>
      </footer>
    </main>
  </body>
</html>
