---
import "../styles/global.css";
import AnimatedBackground from "../components/AnimatedBackground.astro";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body class="night-design">
    <AnimatedBackground />

    <main>
      <header class="hero">
        <div class="hero-heart">♡</div>
        <h1>sarahwhitaker</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="intro">STATISTICS&nbsp;&nbsp;·&nbsp;&nbsp; QA&nbsp;&nbsp; ·&nbsp;&nbsp; DATA&nbsp;&nbsp; ·&nbsp;&nbsp; RESEARCH</p>
      </header>

      <section id="work">
        <div class="section-heading">
          <span></span>
          <p class="section-label">FEATURED WORK</p>
          <span></span>
        </div>

        <div class="work-grid">
          <div class="project">
            <span class="project-ornament">✦</span>
            <h2>DATA &amp; STATISTICS</h2>
            <p>analysis&nbsp;&nbsp; · &nbsp;&nbsp;research&nbsp;&nbsp; · &nbsp;&nbsp;modeling</p>
            <span class="project-link">→</span>
          </div>

          <div class="project">
            <span class="project-ornament">♡</span>
            <h2>QA &amp; AUTOMATION</h2>
            <p>testing&nbsp;&nbsp; · &nbsp;&nbsp;automation&nbsp;&nbsp; · &nbsp;&nbsp;payments</p>
            <span class="project-link">→</span>
          </div>
        </div>
      </section>

      <footer>
        <nav class="social-links" aria-label="Social links">
          <a href="https://github.com/sarahlouisewhitaker" target="_blank" rel="noopener noreferrer">GITHUB</a>
          <span aria-hidden="true">♡</span>
          <a href="https://www.linkedin.com/in/sarahlouisewhitaker" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
        </nav>
        <div class="footer-note">
          <span>♡</span>
          <span>made with curiosity</span>
          <span>♡</span>
        </div>
      </footer></main>
  </body>
</html>
