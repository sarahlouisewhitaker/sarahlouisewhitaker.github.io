---
import "../styles/global.css";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <div class="site-frame" aria-hidden="true">
        <span class="corner top-left"><svg class="corner-art" viewBox="0 0 120 120" aria-hidden="true"><g class="branch"><path d="M18 92 L28 72 L39 51 L48 38 L68 28 L94 14"/><path d="M39 51 L23 39 L12 27"/><path d="M48 38 L54 22 L62 10"/><path d="M68 28 L77 18 L89 8"/><path d="M28 72 L17 61 L8 56"/></g><g class="blossom-svg"><path d="M43 35h6v5h6v6h-4v7h-6v5h-6v-5h-6v-7h-4v-6h6v-5h8z"/><path d="M42 26h6v9h-6z M33 34h8v6h-8z M49 34h8v6h-8z M37 47h6v8h-6z M45 47h6v8h-6z"/><rect x="43" y="39" width="6" height="6" class="center"/></g><g class="small-flower"><path d="M79 15h5v4h4v5h-4v5h-5v-4h-5v-5h5z"/><rect x="78" y="20" width="6" height="6" class="center"/></g><g class="small-flower" transform="translate(-10 43)"><path d="M79 15h5v4h4v5h-4v5h-5v-4h-5v-5h5z"/><rect x="78" y="20" width="6" height="6" class="center"/></g><g class="bud-svg" transform="translate(14 2)"><path d="M0 7h5v5H0z"/></g><g class="bud-svg" transform="translate(2 18)"><path d="M0 7h5v5H0z"/></g><g class="bud-svg" transform="translate(66 2)"><path d="M0 7h5v5H0z"/></g><g class="sparkles"><path d="M101 31h3v6h-3z M99 33h7v3h-7z"/><path d="M58 63h3v6h-3z M56 65h7v3h-7z"/><path d="M72 82h3v6h-3z M70 84h7v3h-7z"/></g></svg></span>
        <span class="corner top-right"><svg class="corner-art" viewBox="0 0 120 120" aria-hidden="true"><g class="branch"><path d="M18 92 L28 72 L39 51 L48 38 L68 28 L94 14"/><path d="M39 51 L23 39 L12 27"/><path d="M48 38 L54 22 L62 10"/><path d="M68 28 L77 18 L89 8"/><path d="M28 72 L17 61 L8 56"/></g><g class="blossom-svg"><path d="M43 35h6v5h6v6h-4v7h-6v5h-6v-5h-6v-7h-4v-6h6v-5h8z"/><path d="M42 26h6v9h-6z M33 34h8v6h-8z M49 34h8v6h-8z M37 47h6v8h-6z M45 47h6v8h-6z"/><rect x="43" y="39" width="6" height="6" class="center"/></g><g class="small-flower"><path d="M79 15h5v4h4v5h-4v5h-5v-4h-5v-5h5z"/><rect x="78" y="20" width="6" height="6" class="center"/></g><g class="small-flower" transform="translate(-10 43)"><path d="M79 15h5v4h4v5h-4v5h-5v-4h-5v-5h5z"/><rect x="78" y="20" width="6" height="6" class="center"/></g><g class="bud-svg" transform="translate(14 2)"><path d="M0 7h5v5H0z"/></g><g class="bud-svg" transform="translate(2 18)"><path d="M0 7h5v5H0z"/></g><g class="bud-svg" transform="translate(66 2)"><path d="M0 7h5v5H0z"/></g><g class="sparkles"><path d="M101 31h3v6h-3z M99 33h7v3h-7z"/><path d="M58 63h3v6h-3z M56 65h7v3h-7z"/><path d="M72 82h3v6h-3z M70 84h7v3h-7z"/></g></svg></span>
