---
import "../styles/global.css";

const title = "sarahwhitaker";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker is a statistics graduate working in QA, automation, data, and research." />
    <title>{title}</title>
  </head>
  <body class="night-design">
    <div class="sky-art" aria-hidden="true">
  <svg class="pixel-sky" viewBox="0 0 480 330" role="presentation" focusable="false" shape-rendering="crispEdges">
    <g class="pixel-moon">
      <path fill="#f7eddc" d="M240 20h20v4h12v4h8v8h4v16h-4v8h-8v4h-12v4h-20v-4h-8v-8h-4V32h4v-8h8z"/>
      <path fill="#080a18" d="M260 24h12v4h8v8h4v16h-4v8h-8v4h-12v-4h-8v-8h-4V36h4v-8h8z"/>
      <rect x="236" y="28" width="4" height="4" fill="#fff8e9"/>
      <rect x="232" y="32" width="4" height="20" fill="#fff8e9"/>
      <rect x="236" y="52" width="4" height="4" fill="#ead8cc"/>
    </g>
    <g class="pixel-stars" fill="#f7d8e6">
      <path d="M77 31h4v8h8v4h-8v8h-4v-8h-8v-4h8z"/>
      <path d="M153 71h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M330 44h4v8h8v4h-8v8h-4v-8h-8v-4h8z"/>
      <path d="M405 85h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M365 145h4v8h8v4h-8v8h-4v-8h-8v-4h8z"/>
      <path d="M110 169h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M294 194h4v4h4v4h-4v4h-4v-4h-4v-4h4z"/>
      <path d="M436 211h4v8h8v4h-8v8h-4v-8h-8v-4h8z"/>
      <rect x="188" y="29" width="4" height="4"/>
      <rect x="390" y="36" width="4" height="4"/>
      <rect x="44" y="145" width="4" height="4"/>
    </g>
    <g class="pixel-branch">
      <path fill="#332438" d="M0 105h16v-4h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v8h-16v8h-16v8h-16v8h-16v8H80v8H64v8H48v8H32v8H16v8H0z"/>
      <path fill="#60435d" d="M0 101h16v-4h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v-8h16v4h-16v8h-16v8h-16v8h-16v8h-16v8H80v8H64v8H48v8H32v8H16v8H0z"/>
      <path fill="#332438" d="M52 77h8V61h8V45h8v32h-8v8h-8v8h-8zm68-48h8V13h8V5h8v32h-8v8h-8v8h-8zm32 80h8v-16h8V77h8v32h-8v8h-8v8h-8z"/>
      <g fill="#efb4ca">
        <path d="M20 72h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M84 40h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M132 16h8V8h8v8h8v8h-8v8h-8v-8h-8z"/>
        <path d="M160 84h8v-8h8v8h8v8h-8v8h-8v-8h-8z"/>
      </g>
      <g fill="#b96891">
        <rect x="28" y="72" width="8" height="8"/>
        <rect x="92" y="40" width="8" height="8"/>
        <rect x="140" y="16" width="8" height="8"/>
        <rect x="168" y="84" width="8" height="8"/>
      </g>
      <g fill="#fff0bf">
        <rect x="30" y="74" width="4" height="4"/>
        <rect x="94" y="42" width="4" height="4"/>
        <rect x="142" y="18" width="4" height="4"/>
        <rect x="170" y="86" width="4" height="4"/>
      </g>
      <rect x="111" y="47" width="8" height="8" fill="#efb4ca"/>
      <rect x="148" y="56" width="8" height="8" fill="#efb4ca"/>
    </g>
  </svg>
</div>
      <div class="stars">
        <i class="star star-1"></i>
        <i class="star star-2"></i>
        <i class="star star-3"></i>
        <i class="star star-4"></i>
        <i class="star star-5"></i>
        <i class="star star-6"></i>
        <i class="star star-7"></i>
        <i class="star star-8"></i>
      </div>

      <div class="branch branch-left">
        <span class="twig twig-1"></span>
        <span class="twig twig-2"></span>
        <span class="twig twig-3"></span>
        <span class="twig twig-4"></span>
        <i class="blossom blossom-a"></i>
        <i class="blossom blossom-b"></i>
        <i class="blossom blossom-c"></i>
        <i class="blossom blossom-d"></i>
        <i class="bud bud-a"></i>
        <i class="bud bud-b"></i>
      </div>
    </div>

    <main>
      <header class="hero">
        <div class="hero-heart">♡</div>
        <h1>sarahwhitaker</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="intro">STATISTICS&nbsp;&nbsp;·&nbsp;&nbsp; QA&nbsp;&nbsp; ·&nbsp;&nbsp; DATA&nbsp;&nbsp; ·&nbsp;&nbsp; RESEARCH</p>
      </header>

      <section id="work">
        <div class="section-heading">
          <span></span>
          <p class="section-label">FEATURED WORK</p>
          <span></span>
        </div>

        <div class="work-grid">
          <a class="project" href="#about">
            <span class="project-ornament">✦</span>
            <h2>DATA &amp; STATISTICS</h2>
            <p>analysis&nbsp;&nbsp; · &nbsp;&nbsp;research&nbsp;&nbsp; · &nbsp;&nbsp;modeling</p>
            <span class="project-link">→</span>
          </a>

          <a class="project" href="#writing">
            <span class="project-ornament">♡</span>
            <h2>QA &amp; AUTOMATION</h2>
            <p>testing&nbsp;&nbsp; · &nbsp;&nbsp;automation&nbsp;&nbsp; · &nbsp;&nbsp;payments</p>
            <span class="project-link">→</span>
          </a>
        </div>
      </section>

      <section id="about" class="about-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">A LITTLE ABOUT ME</p>
          <span></span>
        </div>
        <div class="about-copy">
          <p>I'm a statistics graduate interested in</p>
          <p>data, quality, automation, and</p>
          <p>building thoughtful things.</p>
        </div>
      </section>

      <section id="writing" class="writing-section">
        <div class="section-heading">
          <span></span>
          <p class="section-label">WRITING</p>
          <span></span>
        </div>
        <p class="writing-copy">notes, projects, and things i learn along the way.</p>
        <span class="coming-soon">COMING SOON</span>
      </section>

      <footer>
        <span>♡</span>
        <span>made with curiosity</span>
        <span>♡</span>
      </footer>
    </main>
  </body>
</html>
