---
import "../../styles/global.css";
import AnimatedBackground from "../../components/AnimatedBackground.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sarah Whitaker's freelance manual QA work for Real Afters." />
    <title>Website QA — Afters. · sarahwhitaker</title>
  </head>
  <body class="night-design project-page">
    <AnimatedBackground />

    <main>
      <header class="project-hero">
        <a class="back-link" href="/">♡ back home</a>
        <p class="project-kicker">FEATURED WORK</p>
        <h1>Website QA — Afters.</h1>
        <div class="floral-divider" aria-hidden="true">
          <span></span><b>✿</b><span></span>
        </div>
        <p class="project-subtitle">freelance · manual testing · exploratory testing</p>
      </header>

      <article class="case-study">
        <section class="case-section">
          <p class="section-label">OVERVIEW</p>
          <p>
            For this freelance project, I manually tested the <a class="inline-project-link" href="https://realafters.com/" target="_blank" rel="noopener noreferrer">Afters.</a> customer experience by
            walking through user flows, interacting with buttons and links, and looking for
            unexpected behavior. I documented functional issues, UI problems, navigation
            concerns, inconsistent results, and other UX observations.
          </p>
        </section>

        <section class="case-section">
          <p class="section-label">TESTING APPROACH</p>
          <div class="case-grid">
            <div class="case-card">
              <span class="case-number">01</span>
              <h2>Customer flows</h2>
              <p>Walk through the customer experience and test the different paths a user can take.</p>
            </div>
            <div class="case-card">
              <span class="case-number">02</span>
              <h2>Exploratory testing</h2>
              <p>Interact with buttons, links, search, navigation, and other site functionality to uncover unexpected behavior.</p>
            </div>
            <div class="case-card">
              <span class="case-number">03</span>
              <h2>Findings</h2>
              <p>Document clear reproduction details and distinguish functional issues from UI and UX observations.</p>
            </div>
            <div class="case-card">
              <span class="case-number">04</span>
              <h2>UX observations</h2>
              <p>Flag confusing interactions and opportunities where the experience could be clearer for users.</p>
            </div>
          </div>
        </section>

        <section class="case-section">
          <p class="section-label">HOW I WORK</p>
          <div class="process">
            <div><span>01</span><p>Understand the expected user behavior</p></div>
            <div><span>02</span><p>Walk through the flow and explore edge cases</p></div>
            <div><span>03</span><p>Document findings clearly</p></div>
            <div><span>04</span><p>Separate functional issues from UX observations</p></div>
          </div>
        </section>

        <section class="case-section closing-section">
          <p class="section-label">THE TAKEAWAY</p>
          <p>
            The testing produced 11 documented findings and observations across the customer flow,
            including navigation, search behavior, UI readability, result consistency, and
            expected save or tracking behavior.
          </p>
        </section>
      </article>

      <footer>
        <nav class="social-links" aria-label="Social links">
          <a href="https://github.com/sarahlouisewhitaker" target="_blank" rel="noopener noreferrer">GITHUB</a>
          <span aria-hidden="true">♡</span>
          <a href="https://www.linkedin.com/in/sarah-louise-whitaker" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
        </nav>
      </footer>
    </main>
  </body>
</html>
